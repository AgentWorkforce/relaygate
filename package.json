{
  "name": "relaygate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Group permissions and egress control for agents, in front of Relaycast and Sessions",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "explain": "tsx src/explain-cli.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "bin": {
    "relaygate-explain": "dist/explain-cli.js"
  },
  "license": "FSL-1.1-ALv2"
}
